{
  "name": "copilotkit-acp-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:bridge": "cargo run --manifest-path ../../Cargo.toml -p agui-acp-bridge-cli -- --max-sessions 16 opencode acp",
    "dev:bridge:echo": "cargo run --manifest-path ../../Cargo.toml -p agui-acp-bridge-cli -- --max-sessions 16 --in-process",
    "dev:bridge:hitl": "cargo run --manifest-path ../../Cargo.toml -p agui-acp-bridge-cli -- --max-sessions 16 --policy interrupt -- opencode acp",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.53",
    "@copilotkit/react-core": "1.58.0",
    "@copilotkit/react-ui": "1.58.0",
    "@copilotkit/runtime": "1.58.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "sharp": "0.35.3",
    "postcss": "8.5.23",
    "nanoid": "3.3.18",
    "js-yaml": "4.3.1",
    "hono": "4.12.34",
    "ip-address": "10.3.1",
    "dompurify": "3.4.7",
    "fast-uri": "3.1.5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
