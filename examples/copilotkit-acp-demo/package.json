{
  "name": "copilotkit-acp-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:bridge": "cargo run --manifest-path ../../Cargo.toml -p agui-acp-bridge-cli -- --max-sessions 16 opencode acp",
    "dev:bridge:echo": "cargo run --manifest-path ../../Cargo.toml -p agui-acp-bridge-cli -- --max-sessions 16 --in-process",
    "dev:bridge:hitl": "cargo run --manifest-path ../../Cargo.toml -p agui-acp-bridge-cli -- --max-sessions 16 --policy interrupt -- opencode acp",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "bun test tests && node --test tests/katex-compat.test.mjs tests/undici-compat.test.mjs tests/uuid-compat.test.mjs",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@copilotkit/react-core": "1.67.1",
    "@copilotkit/react-ui": "1.67.1",
    "@copilotkit/runtime": "1.67.1",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "sharp": "0.35.5",
    "postcss": "8.5.23",
    "nanoid": "3.3.18",
    "js-yaml": "4.3.2",
    "hono": "4.13.7",
    "ip-address": "10.7.1",
    "dompurify": "3.4.16",
    "katex": "0.18.2",
    "fast-uri": "3.1.8",
    "undici": "6.29.0",
    "uuid": "11.1.1"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "patchedDependencies": {
    "braces@3.0.3": "patches/braces@3.0.3.patch"
  }
}
